<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.polar.swedishmeritscorecalculator.CreationInterfaceController">
   <children>
      <Label layoutX="5.0" layoutY="7.0" text="Create Programme &amp; Student">
         <font>
            <Font name="System Italic" size="21.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" layoutX="258.0" layoutY="44.0" prefHeight="482.0" prefWidth="285.0" spacing="10.0">
         <children>
            <Label text="Programme">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <TextField fx:id="programNameInput" prefHeight="39.0" prefWidth="174.0" promptText="input programme name">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#triggerNewProgramme" prefHeight="40.0" prefWidth="120.0" text="Create Programme">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#switchToProgramme" prefHeight="40.0" prefWidth="120.0" text="Add Courses">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
            <Region prefHeight="4.0" prefWidth="285.0" />
            <Line endX="180.0" startX="-100.0" />
            <Label text="Student">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <TextField fx:id="studentNameInput" prefHeight="39.0" prefWidth="329.0" promptText="input student name">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <ComboBox fx:id="programmesOptions" prefHeight="31.0" prefWidth="220.0" promptText="Programmes" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#triggerNewStudent" prefHeight="40.0" prefWidth="120.0" text="Create Student">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" text="Grades">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
